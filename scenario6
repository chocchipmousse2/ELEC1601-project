
// Scenario 6: right sensor much closer to the wall than the right -> re-center

#include <Servo.h>

Servo servoLeft;
Servo servoRight;

void setup()
{
  pinMode(A0, OUTPUT);   // right LED
  pinMode(A1, OUTPUT);   // middle LED
  pinMode(A2, OUTPUT);   // left LED
  stopRobot();
  delay(3000);           // time to put the robot down
}

void loop()
{
  // read sensors (IR LED pin, receiver pin): 0 = no wall ... 5 = very close
  int left = irDistance(10, 11);
  int front = irDistance(6, 7);
  int right = irDistance(2, 3);

  if (left >= 1 && right >= 1 && left - right >= 1 && front <= 1)
  {
    digitalWrite(A1, HIGH);
    digitalWrite(A2, HIGH);
    turnLeft();          // 1. rotate anticlockwise slightly
    delay(300);
    stopRobot();
    delay(300);
    forward();           // 2. move forward
    delay(300);
    stopRobot();
    delay(300);
    int startRight = irDistance(2, 3);
    turnRight();         // 3. rotate clockwise back to parallel
    for (int i = 0; i < 30; i++)          // check about every 10 ms (max ~0.3 s)
    {
      if (irDistance(2, 3) > startRight)  // right sensor picks up its wall = parallel
      {
        break;
      }
    }
    stopRobot();
    delay(300);
    backward();          // 4. reverse to be level with the start
    delay(210);

    stopRobot();
    while (true) { }     // finished, stay here forever
  }
}

// counts how many of 38-42 kHz see a wall (close walls are seen at all 5)
int irDistance(int irLedPin, int receiverPin)
{
  int count = 0;
  for (long f = 38000; f <= 42000; f = f + 1000)
  {
    tone(irLedPin, f);
    delay(1);
    if (digitalRead(receiverPin) == 0)   // 0 = saw something
    {
      count = count + 1;
    }
    noTone(irLedPin);
    delay(1);
  }
  return count;
}

void forward()
{
  servoLeft.attach(13);
  servoRight.attach(12);
  servoLeft.writeMicroseconds(1700);
  servoRight.writeMicroseconds(1300);
}

void backward()
{
  servoLeft.attach(13);
  servoRight.attach(12);
  servoLeft.writeMicroseconds(1300);
  servoRight.writeMicroseconds(1700);
}

void turnRight()   // clockwise
{
  servoLeft.attach(13);
  servoRight.attach(12);
  servoLeft.writeMicroseconds(1700);
  servoRight.writeMicroseconds(1700);
}

void turnLeft()    // anticlockwise
{
  servoLeft.attach(13);
  servoRight.attach(12);
  servoLeft.writeMicroseconds(1300);
  servoRight.writeMicroseconds(1300);
}

// cut the signal to the servos so the wheels stop completely
void stopRobot()
{
  servoLeft.detach();
  servoRight.detach();
}
