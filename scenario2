
#include <Servo.h>

Servo servoLeft;
Servo servoRight;

// IR sensor pins
const int leftLedPin = 10;
const int leftReceiverPin = 11;
const int middleLedPin = 6;
const int middleReceiverPin = 7;
const int rightLedPin = 2;
const int rightReceiverPin = 3;

// Status LEDs
const int ledRight = A0;
const int ledMid = A1;
const int ledLeft = A2;

// ==========================================
// SETTINGS TO TUNE
// ==========================================
// A sensor reading = how many of 38-42 kHz see a wall (from your calibration):
// 0 = no wall (more than ~7 cm), 1 = ~7 cm, 2 = ~5 cm, 3 = ~4 cm, 4 = ~3 cm, 5 = under 2 cm

const int FRONT_MIN = 1;   // front wall closer than ~7 cm...
const int FRONT_MAX = 4;   // ...but not closer than ~3 cm

const int TURN_90_MS = 572;             // time to rotate 90 degrees (from your group's code)
const int FORWARD_AFTER_TURN_MS = 1000; // time to drive into the new corridor after turning
const int CORRIDOR_FORWARD_MS = 300;    // time to drive 5 cm
const int START_DELAY_MS = 5000;        // time to put the robot down

bool done = false;

void setup()
{
  Serial.begin(9600);

  servoLeft.attach(13);
  servoRight.attach(12);

  pinMode(leftLedPin, OUTPUT);
  pinMode(leftReceiverPin, INPUT);
  pinMode(middleLedPin, OUTPUT);
  pinMode(middleReceiverPin, INPUT);
  pinMode(rightLedPin, OUTPUT);
  pinMode(rightReceiverPin, INPUT);

  pinMode(ledRight, OUTPUT);
  pinMode(ledMid, OUTPUT);
  pinMode(ledLeft, OUTPUT);

  stopRobot();

  // Blink all LEDs while you place the robot
  unsigned long start = millis();
  while (millis() - start < START_DELAY_MS)
  {
    int state = (millis() / 250) % 2;
    setLeds(state, state, state);
  }
  setLeds(LOW, LOW, LOW);
}

void loop()
{
  if (done)
  {
    return;   // finished -> stay stopped until reset
  }

  int left  = irSeen(leftLedPin, leftReceiverPin);
  int front = irSeen(middleLedPin, middleReceiverPin);
  int right = irSeen(rightLedPin, rightReceiverPin);

  Serial.print("Left: ");
  Serial.print(left);
  Serial.print("  Front: ");
  Serial.print(front);
  Serial.print("  Right: ");
  Serial.println(right);

  // ==========================================
  // SCENARIO: wall on left, wall ahead, open on right -> turn right
  // ==========================================
  if (right == 0 && left >= 1 && front >= FRONT_MIN && front <= FRONT_MAX)
  {
    Serial.println(">> TURN RIGHT");
    setLeds(LOW, HIGH, LOW);          // A0 OFF, A1 ON, A2 OFF

    stopRobot();
    delay(200);

    turnRight();
    delay(TURN_90_MS);

    stopRobot();
    delay(200);

    driveCentered(FORWARD_AFTER_TURN_MS);
  }

  // ==========================================
  // SCENARIO: corridor -> forward 5 cm
  // ==========================================
  else if (left >= 1 && right >= 1 && abs(left - right) <= 1 && front == 0)
  {
    Serial.println(">> CORRIDOR");
    setLeds(HIGH, LOW, LOW);          // A0 ON, A1 OFF, A2 OFF
    driveCentered(CORRIDOR_FORWARD_MS);
  }

  // ==========================================
  // SCENARIO: lost -> don't move
  // ==========================================
  else
  {
    Serial.println(">> LOST");
    setLeds(LOW, LOW, LOW);           // all OFF
  }

  // Stop after completion
  stopRobot();
  servoLeft.detach();
  servoRight.detach();
  done = true;
}


// ==========================================
// DRIVE FORWARD FOR ms, STAYING CENTERED
// Only steers when it can see BOTH walls.
// ==========================================
void driveCentered(unsigned long ms)
{
  unsigned long start = millis();

  while (millis() - start < ms)
  {
    int left  = irSeen(leftLedPin, leftReceiverPin);
    int right = irSeen(rightLedPin, rightReceiverPin);

    if (left >= 1 && right >= 1 && left > right + 1)
    {
      // too close to left wall -> steer right
      servoLeft.writeMicroseconds(1700);
      servoRight.writeMicroseconds(1400);
    }
    else if (left >= 1 && right >= 1 && right > left + 1)
    {
      // too close to right wall -> steer left
      servoLeft.writeMicroseconds(1600);
      servoRight.writeMicroseconds(1300);
    }
    else
    {
      forward();
    }
  }

  stopRobot();
}


// ==========================================
// LEDS
// ==========================================
void setLeds(int rightState, int midState, int leftState)
{
  digitalWrite(ledRight, rightState);
  digitalWrite(ledMid, midState);
  digitalWrite(ledLeft, leftState);
}


// ==========================================
// IR: how many of 38-42 kHz see a wall (0 = none, 5 = very close)
// ==========================================
int irSeen(int irLedPin, int irReceiverPin)
{
  int seen = 0;
  for (long f = 38000; f <= 42000; f += 1000)
  {
    if (irDetect(irLedPin, irReceiverPin, f) == 0)
    {
      seen++;
    }
  }
  return seen;
}

// 0 = object detected, 1 = no object (majority of 3 reads to filter noise)
int irDetect(int irLedPin, int irReceiverPin, long frequency)
{
  int hits = 0;
  for (int k = 0; k < 3; k++)
  {
    tone(irLedPin, frequency);
    delay(1);
    if (digitalRead(irReceiverPin) == 0) hits++;
    noTone(irLedPin);
    delay(1);
  }
  return (hits >= 2) ? 0 : 1;
}


// ==========================================
// MOTION (same as your group's code)
// ==========================================
void forward()
{
  servoLeft.writeMicroseconds(1700);
  servoRight.writeMicroseconds(1300);
}

void turnRight()
{
  servoLeft.writeMicroseconds(1700);
  servoRight.writeMicroseconds(1700);
}

void stopRobot()
{
  servoLeft.writeMicroseconds(1500);
  servoRight.writeMicroseconds(1500);
}
